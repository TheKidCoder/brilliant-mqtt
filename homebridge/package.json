{
  "name": "homebridge-brilliant-mqtt",
  "displayName": "Brilliant MQTT",
  "version": "0.1.0",
  "description": "Homebridge platform for Brilliant smart-home panels, via the brilliant-mqtt on-panel agent",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "brilliant-homebridge": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "agent-payload",
    "config.schema.json",
    "README.md"
  ],
  "keywords": [
    "homebridge-plugin",
    "brilliant",
    "mqtt",
    "homekit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheKidCoder/brilliant-mqtt.git",
    "directory": "homebridge"
  },
  "engines": {
    "node": "^20.18.0 || ^22.12.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/sync-payload.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "mqtt": "^5.16.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1.15.5",
    "homebridge": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
